# Copy to .env at the repository root. Docker Compose reads this file when it
# exists and overrides HP_DATABASE_URL for containers so they reach the
# postgres service by name.

# local or production
HP_ENVIRONMENT=local
HP_LOG_LEVEL=INFO

HP_API_HOST=0.0.0.0
HP_API_PORT=8000
# JSON list. The browser origin of the Next.js app.
HP_CORS_ORIGINS=["http://localhost:3000"]

# Host-side URL. Compose replaces this inside the api and worker containers.
HP_DATABASE_URL=postgresql+psycopg://honest_practice:honest_practice@localhost:5432/honest_practice
HP_HEALTH_CHECK_DATABASE=true

# The Cursor SDK reads CURSOR_API_KEY. Leave it empty until Phase 2.
CURSOR_API_KEY=
HP_CURSOR_MODEL=composer-2.5
HP_CURSOR_RUNTIME=local
HP_AGENT_SANDBOX_DIR=/var/lib/honest-practice/sandbox

HP_BUDGET_PER_RUN_USD=1.0
HP_BUDGET_PER_DAY_USD=5.0
HP_EDITION_PATTERN_COUNT=5
HP_WORKER_HEARTBEAT_SECONDS=30

# Baked into the web image at build time. The browser calls this URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
